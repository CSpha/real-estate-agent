# Copy this file to .env and replace the password before starting the app.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=realestate
DB_USER=realestate
DB_PASSWORD=replace-with-a-local-password

# Optional alternative to the DB_* values above:
# DATABASE_URL=postgresql+psycopg2://realestate:password@localhost:5432/realestate

# Required only when actually sending Slack alerts. Keep this secret.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
# Optional separate channel for process_alert_outbox --test-channel and
# send_test_alerts. Must differ from SLACK_WEBHOOK_URL.
# SLACK_TEST_WEBHOOK_URL=https://hooks.slack.com/services/replace/test

# Required only when using the RentCast provider. Keep this secret.
# RENTCAST_API_KEY=replace-with-your-rentcast-api-key

# Optional channel for shadow-pipeline failure/overdue/recovery warnings.
# It never receives listing alerts. Test with: python -m app.ops.notify --test
# SLACK_OPS_WEBHOOK_URL=https://hooks.slack.com/services/replace/ops

# Optional external heartbeat (for example a Healthchecks.io check with a 3-day
# period and 7-hour grace), pinged after each successful shadow run. Keep it
# secret. Test with: python -m app.ops.heartbeat --test
# SHADOW_HEARTBEAT_URL=https://hc-ping.com/replace-with-your-check-uuid

# Pipeline/worker log format: text (default) or json (one object per line).
# LOG_FORMAT=text

# Dedicated shadow runner cadence. It has no listing-alert webhook.
# SHADOW_INTERVAL_HOURS=72
# SHADOW_RETRY_HOURS=6
# SHADOW_INITIAL_DELAY_HOURS=0
# SHADOW_OVERDUE_GRACE_MINUTES=15
# Scheduled RentCast refreshes (3 requests each, up to 9 with retries) are off
# unless enabled.
# SHADOW_ENABLE_RENTCAST_API_CALLS=false
# SHADOW_RENTCAST_MIN_HOURS=60
# SHADOW_RENTCAST_MONTHLY_REQUEST_LIMIT=40

# Enable before any non-local deployment. Use a long random value; never commit it.
# API_AUTH_REQUIRED=true
# API_AUTH_TOKEN=replace-with-a-long-random-token
# API_RATE_LIMIT_PER_MINUTE=120

# Backup profile: verify the newest dump by restoring it into a disposable database.
# BACKUP_VERIFY_INTERVAL_SECONDS=604800
# BACKUP_VERIFY_RETRY_SECONDS=3600
