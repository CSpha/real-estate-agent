# Copy this file to .env and replace the password before starting the app.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=realestate
DB_USER=realestate
DB_PASSWORD=replace-with-a-local-password

# Optional alternative to the DB_* values above:
# DATABASE_URL=postgresql+psycopg2://realestate:password@localhost:5432/realestate

# Required only when actually sending Slack alerts. Keep this secret.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
