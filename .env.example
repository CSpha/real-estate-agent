# Copy this file to .env and replace the password before starting the app.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=realestate
DB_USER=realestate
DB_PASSWORD=replace-with-a-local-password

# Optional alternative to the DB_* values above:
# DATABASE_URL=postgresql+psycopg2://realestate:password@localhost:5432/realestate

# Required only when actually sending Slack alerts. Keep this secret.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me

# Required only when using the RentCast provider. Keep this secret.
# RENTCAST_API_KEY=replace-with-your-rentcast-api-key

# Dedicated shadow runner cadence. It has no Slack webhook configuration.
# SHADOW_INTERVAL_HOURS=72
# SHADOW_RETRY_HOURS=6
# SHADOW_INITIAL_DELAY_HOURS=0

# Enable before any non-local deployment. Use a long random value; never commit it.
# API_AUTH_REQUIRED=true
# API_AUTH_TOKEN=replace-with-a-long-random-token
# API_RATE_LIMIT_PER_MINUTE=120

# Backup profile: verify the newest dump by restoring it into a disposable database.
# BACKUP_VERIFY_INTERVAL_SECONDS=604800
# BACKUP_VERIFY_RETRY_SECONDS=3600
